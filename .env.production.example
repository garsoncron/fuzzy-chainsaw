# Production Environment Variables for Cowtown Showdown Tournament
# Copy this file to .env.production.local and fill in your production values

# Database connection string - PostgreSQL recommended for production
DATABASE_URI=postgresql://username:password@hostname:5432/cowtown_tournament_prod

# Security secrets - Generate strong, unique values for production
PAYLOAD_SECRET=your-super-secure-payload-secret-here-min-32-chars
CRON_SECRET=your-cron-job-secret-here
PREVIEW_SECRET=your-preview-mode-secret-here

# Production domain configuration - NO trailing slash
NEXT_PUBLIC_SERVER_URL=https://your-tournament-domain.com

# Authentication & Security
JWT_SECRET=your-jwt-signing-secret-here-min-32-chars
CSRF_SECRET=your-csrf-protection-secret-here

# Session timeouts (in seconds)
SCOREKEEPER_SESSION_TIMEOUT=14400  # 4 hours for scorekeepers
ADMIN_SESSION_TIMEOUT=86400        # 24 hours for admins

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100        # Default max requests per window

# Real-time updates
REALTIME_UPDATE_INTERVAL=1000      # 1 second for live games

# Audit & compliance
AUDIT_LOG_RETENTION_DAYS=365       # Keep audit logs for 1 year

# Email configuration (optional - for notifications)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=

# Analytics & monitoring (optional)
# GOOGLE_ANALYTICS_ID=
# SENTRY_DSN=

# CDN & media (optional)
# CLOUDINARY_URL=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Feature flags
# ENABLE_TOURNAMENT_REGISTRATION=true
# ENABLE_LIVE_STREAMING=true
# ENABLE_STATS_EXPORT=true